<?xml version="1.0" encoding="UTF-8" ?>
<settings>
	<setting id="SIPGroup1Enable" value="1" override="true"/>
	<setting id="SIPGroup1AuthenticationName" value="{{USERNAME}}" override="true"/>
	<setting id="SIPGroup1AuthenticationPassword" value="{{PASSWORD}}" override="true"/>
	<setting id="SIPGroup1DeviceUri" value="{{USERNAME}}" override="true"/>
	<setting id="SIPGroup1LabelName" value="{{EXTENSION}}" override="true"/>
	<setting id="SIPGroup1DisplayName" value="{{EXTENSION}}" override="true"/>
	<setting id="SIPServer1Address" value="{{PBX_IP}}" override="true"/>
	<setting id="SIPServer1Port" value="{{SIP_PORT}}" override="true"/>
	<setting id="SIPGroup1TransportMode" value="{{TRANSPORT}}" override="true"/>
	<setting id="SIPGroup1DtmfMode" value="2" override="true"/>
	<setting id="SIPServer1RegisterExpire" value="3600" override="true"/>
	<setting id="SIPServer1KeepAliveEnable" value="true" override="true"/>
	<setting id="Account1MwiUri" value="" override="true"/>
	<setting id="Account1VmNumber" value="*97" override="true"/>
	<setting id="FeatureDndMode" value="0" override="true"/>
	<setting id="FeatureDNDMethod" value="0" override="true"/>
	<setting id="FeatureDndOnCode" value="{{DND_ON_CODE}}" override="true"/>
	<setting id="FeatureDndOffCode" value="{{DND_OFF_CODE}}" override="true"/>
	<setting id="FeatureFwdMode" value="0" override="true"/>
	<setting id="FeatureFwdMethod" value="0" override="true"/>
	<setting id="FeatureImmFwdOnCode" value="{{CF_ALL_ON_CODE}}" override="true"/>
	<setting id="FeatureImmFwdOffCode" value="{{CF_ALL_OFF_CODE}}" override="true"/>
	<setting id="FeatureBusyFwdOnCode" value="{{CF_BUSY_ON_CODE}}" override="true"/>
	<setting id="FeatureBusyFwdOffCode" value="{{CF_BUSY_OFF_CODE}}" override="true"/>
	<setting id="FeatureNoReplyFwdOnCode" value="{{CF_NOANSWER_ON_CODE}}" override="true"/>
	<setting id="FeatureNoReplyFwdOffCode" value="{{CF_NOANSWER_OFF_CODE}}" override="true"/>
	<setting id="RemotePhoneBookEnable" value="true" override="true"/>
	<setting id="RemotePhoneBookForceUpdateMode" value="1" override="true"/>
	<setting id="RemotePhoneBookPeriodUpdateEnable" value="true" override="true"/>
	<setting id="RemotePhoneBookInterval" value="3600" override="true"/>
	<setting id="RemotePhoneBook1GroupName" value="{{PHONEBOOK_NAME}}" override="true"/>
	<setting id="RemotePhoneBook1Url" value="{{PHONEBOOK_URL}}" override="true"/>
	<setting id="RemotePhoneBook1AuthName" value="{{PHONEBOOK_USERNAME}}" override="true"/>
	<setting id="RemotePhoneBook1AuthPwd" value="{{PHONEBOOK_PASSWORD}}" override="true"/>
	<setting id="DirectoryList" value="0;1" override="true"/>
	<setting id="FeatureActionUriEnable" value="true" override="true"/>
	<setting id="FeatureActionUriPromptEnable" value="false" override="true"/>
	<setting id="FeatureActionUriLimitIp" value="{{PBX_IP}}" override="true"/>
	<setting id="LocalEnetcfgDmUrl" value="{{PROV_URL}}" override="true"/>
	<setting id="DeviceProvisionServerUrl" value="{{PROV_URL}}" override="true"/>
	<setting id="DmAdmcfgCfgfilePollingEnable" value="true" override="true"/>
	<setting id="DmAdminPasswd" value="{{ADMIN_PASS}}" override="true"/>
	<setting id="LocalEnetcfgDhcpMode" value="{{DHCP_ENABLED}}" override="true"/>
	<setting id="DeviceNetworkDhcpMode" value="{{DHCP_ENABLED}}" override="true"/>
	<setting id="DeviceNetworkIpAddress" value="{{STATIC_IP}}" override="true"/>
	<setting id="DeviceNetworkSubnetMask" value="{{STATIC_MASK}}" override="true"/>
	<setting id="DeviceNetworkGateway" value="{{STATIC_GW}}" override="true"/>
	<setting id="LocalEnetcfgIpaddr" value="{{STATIC_IP}}" override="true"/>
	<setting id="LocalEnetcfgSubnet" value="{{STATIC_MASK}}" override="true"/>
	<setting id="LocalEnetcfgRouter" value="{{STATIC_GW}}" override="true"/>
	<setting id="LocalEnetcfgVlanEnable" value="{{VLAN_ENABLED}}" override="true"/>
	<setting id="LocalEnetcfgVlan" value="{{VLAN_ID}}" override="true"/>
	<setting id="LocalEnetcfgDataVlanEnable" value="{{DATA_VLAN_ENABLED}}" override="true"/>
	<setting id="LocalEnetcfgDataVlan" value="{{DATA_VLAN_ID}}" override="true"/>
	<setting id="DmEnetcfgDns1" value="{{STATIC_DNS}}" override="true"/>
	<setting id="LocalAdmcfgTimeZoneLocation" value="Brunei" override="true"/>
	<setting id="LocalAdmcfgTimeZoneUtoffset" value="+8:00" override="true"/>
	<setting id="LocalAdmcfgDstEnable" value="0" override="true"/>
	<setting id="LocalEnetcfgSntp" value="{{NTP_SERVER}}" override="true"/>
	<setting id="LocalEnetcfgSntp2" value="time.nist.gov" override="true"/>
	<setting id="LocalEnetcfgSntpRefreshPeriod" value="3600" override="true"/>
	<setting id="SIPPreferredVocoder1" value="0;8;18;9;98;125" override="true"/>
</settings>
